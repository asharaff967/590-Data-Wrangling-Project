# Copy to .env and fill in. .env is gitignored, never commit it.

# Your WRDS username. The first connection asks for your password and a Duo push,
# and can save a .pgpass file so later runs only need Duo.
WRDS_USERNAME=

# SEC asks every script to identify itself. Use your real name and Duke email.
SEC_USER_AGENT="Your Name your.netid@duke.edu"

# Window for the pulls. The proposal starts in 2004.
START_DATE=2004-01-01
END_DATE=2025-12-31
